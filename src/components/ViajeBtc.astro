---
import Glosario from './Glosario.astro';
---

<div id="view-viaje" class="tx-view active">
	<div style="background:#0b0c0f;color:#f2f1ed;font-family:'Space Grotesk',sans-serif;position:relative;">
		<section
			style="min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;padding:80px 24px 40px;position:relative;background-image:linear-gradient(rgba(242,241,237,.025) 1px, transparent 1px),linear-gradient(90deg, rgba(242,241,237,.025) 1px, transparent 1px);background-size:64px 64px;"
		>
			<div style="font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.3em;color:#8b8f9c;">
				SIMULACIÓN INTERACTIVA · RED BITCOIN
			</div>
			<h1
				style="font-size:clamp(36px,5.2vw,64px);font-weight:700;margin:0;text-align:center;max-width:800px;line-height:1.06;text-wrap:balance;"
			>
				¿Qué sucede cuando envías Bitcoin?
			</h1>
			<p style="margin:0;color:#8b8f9c;font-size:18px;text-align:center;max-width:520px;line-height:1.5;">
				Sigue una transacción desde la firma hasta sus confirmaciones en la blockchain.
			</p>
			<div
				style="margin-top:16px;position:relative;border:1px solid rgba(242,241,237,.14);background:linear-gradient(170deg,#171a20,#111318);padding:24px 32px;display:flex;flex-direction:column;gap:10px;min-width:280px;font-family:'JetBrains Mono',monospace;box-shadow:0 24px 60px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.05);"
			>
				<div style="position:absolute;top:-1px;left:-1px;width:14px;height:14px;border-top:1.5px solid #f7931a;border-left:1.5px solid #f7931a;">
				</div>
				<div style="position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border-bottom:1.5px solid #f7931a;border-right:1.5px solid #f7931a;">
				</div>
				<div style="display:flex;justify-content:space-between;align-items:center;">
					<span style="font-size:10.5px;letter-spacing:.26em;color:#8b8f9c;">WALLET</span>
					<span style="font-size:9.5px;letter-spacing:.18em;color:#5b8cff;border:1px solid rgba(91,140,255,.35);padding:3px 8px;"
						>LISTA PARA FIRMAR</span
					>
				</div>
				<div style="font-size:32px;font-weight:700;color:#f2f1ed;letter-spacing:-0.01em;">
					<span id="hero-monto">0.005</span> <span style="color:#f7931a;">BTC</span>
				</div>
				<div style="display:flex;flex-direction:column;gap:4px;border-top:1px solid rgba(242,241,237,.08);padding-top:10px;">
					<div style="font-size:12px;color:#8b8f9c;display:flex;justify-content:space-between;gap:24px;">
						<span style="color:#5b5f6b;">To</span><span style="color:#c9c8c2;">bc1q…w0en3</span>
					</div>
					<div style="font-size:12px;color:#8b8f9c;display:flex;justify-content:space-between;gap:24px;">
						<span style="color:#5b5f6b;">Fee</span><span style="color:#c9c8c2;" id="hero-fee">12 sat/vB</span>
					</div>
				</div>
			</div>
			<div style="display:flex;gap:28px;flex-wrap:wrap;justify-content:center;font-family:'JetBrains Mono',monospace;">
				<div style="display:flex;flex-direction:column;gap:8px;align-items:center;">
					<span style="font-size:9.5px;letter-spacing:.24em;color:#5b5f6b;">MONTO</span>
					<div style="display:flex;gap:6px;">
						<button class="tx-pick" data-monto="0.001">0.001</button>
						<button class="tx-pick active" data-monto="0.005">0.005</button>
						<button class="tx-pick" data-monto="0.02">0.020</button>
					</div>
				</div>
				<div style="display:flex;flex-direction:column;gap:8px;align-items:center;">
					<span style="font-size:9.5px;letter-spacing:.24em;color:#5b5f6b;">PRIORIDAD (FEE)</span>
					<div style="display:flex;gap:6px;">
						<button class="tx-pick" data-fee="6">BAJA</button>
						<button class="tx-pick active" data-fee="12">MEDIA</button>
						<button class="tx-pick" data-fee="24">ALTA</button>
					</div>
				</div>
			</div>
			<button
				id="start-sim-btn"
				class="tx-btn-primary"
				style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:.14em;background:#f7931a;color:#0b0c0f;border:none;padding:16px 36px;cursor:pointer;font-weight:700;box-shadow:0 0 0 0 rgba(247,147,26,.4);transition:box-shadow .3s, transform .15s;"
				>ENVIAR TRANSACCIÓN&nbsp;&nbsp;→</button
			>
			<div
				style="position:absolute;bottom:26px;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.24em;color:#5b5f6b;animation:bob 2.4s ease-in-out infinite;"
			>
				SCROLL ↓
			</div>
		</section>
		<div id="tx-sim" style="height:960vh;position:relative;">
			<div
				id="tx-sticky"
				style="position:sticky;top:0;height:100vh;height:100dvh;overflow:hidden;background-image:linear-gradient(rgba(242,241,237,.02) 1px, transparent 1px),linear-gradient(90deg, rgba(242,241,237,.02) 1px, transparent 1px);background-size:64px 64px;"
			>
				<canvas id="tx-canvas" style="position:absolute;inset:0;width:100%;height:100%;display:block;"></canvas>
				<div style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(5,6,8,.55) 100%);">
				</div>
				<div data-prog style="position:absolute;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,#f7931a,#ffb85c);box-shadow:0 0 10px rgba(247,147,26,.8);">
				</div>
				<div data-hud style="position:absolute;top:18px;right:24px;display:flex;align-items:center;gap:12px;font-family:'JetBrains Mono',monospace;opacity:0;transition:opacity .5s;">
					<span style="font-size:11px;letter-spacing:.12em;color:#8b8f9c;">TX <span style="color:#f2f1ed;">4b3f…a2d1</span></span>
					<span data-status style="font-size:10px;letter-spacing:.2em;color:#5b8cff;border:1px solid rgba(91,140,255,.4);padding:5px 10px;background:rgba(11,12,15,.6);backdrop-filter:blur(6px);"
						>FIRMANDO</span
					>
					<button id="sound-toggle" class="tx-sound-btn" title="Sonido">♪ ON</button>
				</div>
				<div data-navwrap style="position:absolute;left:26px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:18px;opacity:0;transition:opacity .5s;padding-left:14px;border-left:1px solid rgba(242,241,237,.1);">
					<button data-nav data-goto="0" class="tx-nav-btn" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#5b5f6b;display:flex;gap:10px;align-items:baseline;transition:color .3s;position:relative;">
						<span data-tick style="position:absolute;left:-15px;top:50%;width:1.5px;height:0;background:#f7931a;transition:height .3s, top .3s;"></span>
						<span style="font-size:10px;">01</span><span>FIRMA</span>
					</button>
					<button data-nav data-goto="1" class="tx-nav-btn" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#5b5f6b;display:flex;gap:10px;align-items:baseline;transition:color .3s;position:relative;">
						<span data-tick style="position:absolute;left:-15px;top:50%;width:1.5px;height:0;background:#f7931a;transition:height .3s, top .3s;"></span>
						<span style="font-size:10px;">02</span><span>MEMPOOL</span>
					</button>
					<button data-nav data-goto="2" class="tx-nav-btn" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#5b5f6b;display:flex;gap:10px;align-items:baseline;transition:color .3s;position:relative;">
						<span data-tick style="position:absolute;left:-15px;top:50%;width:1.5px;height:0;background:#f7931a;transition:height .3s, top .3s;"></span>
						<span style="font-size:10px;">03</span><span>SELECCIÓN</span>
					</button>
					<button data-nav data-goto="3" class="tx-nav-btn" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#5b5f6b;display:flex;gap:10px;align-items:baseline;transition:color .3s;position:relative;">
						<span data-tick style="position:absolute;left:-15px;top:50%;width:1.5px;height:0;background:#f7931a;transition:height .3s, top .3s;"></span>
						<span style="font-size:10px;">04</span><span>PROOF OF WORK</span>
					</button>
					<button data-nav data-goto="4" class="tx-nav-btn" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#5b5f6b;display:flex;gap:10px;align-items:baseline;transition:color .3s;position:relative;">
						<span data-tick style="position:absolute;left:-15px;top:50%;width:1.5px;height:0;background:#f7931a;transition:height .3s, top .3s;"></span>
						<span style="font-size:10px;">05</span><span>BLOQUE</span>
					</button>
					<button data-nav data-goto="5" class="tx-nav-btn" style="background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;color:#5b5f6b;display:flex;gap:10px;align-items:baseline;transition:color .3s;position:relative;">
						<span data-tick style="position:absolute;left:-15px;top:50%;width:1.5px;height:0;background:#f7931a;transition:height .3s, top .3s;"></span>
						<span style="font-size:10px;">06</span><span>CONFIRMACIONES</span>
					</button>
				</div>
				<div style="position:absolute;left:0;right:0;bottom:56px;display:flex;justify-content:center;pointer-events:none;">
					<div
						class="tx-caption-box"
						style="position:relative;width:min(560px,86vw);height:118px;background:rgba(11,12,15,.55);backdrop-filter:blur(8px);border:1px solid rgba(242,241,237,.06);border-radius:6px;padding:8px 0;"
					>
						<div data-stage="0" style="position:absolute;inset:0;opacity:0;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;">
							<div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.28em;color:#f7931a;">STEP 01 / 06 — FIRMA</div>
							<p style="margin:0;color:#c9c8c2;font-size:16px;line-height:1.5;">La wallet firma digitalmente la transacción para demostrar que puede gastar esos fondos.</p>
						</div>
						<div data-stage="1" style="position:absolute;inset:0;opacity:0;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;">
							<div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.28em;color:#f7931a;">STEP 02 / 06 — MEMPOOL</div>
							<p style="margin:0;color:#c9c8c2;font-size:16px;line-height:1.5;">La transacción se transmite a la red y queda temporalmente en el mempool esperando ser incluida en un bloque.</p>
						</div>
						<div data-stage="2" style="position:absolute;inset:0;opacity:0;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;">
							<div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.28em;color:#f7931a;">STEP 03 / 06 — SELECCIÓN</div>
							<p style="margin:0;color:#c9c8c2;font-size:16px;line-height:1.5;">Un minero selecciona transacciones del mempool y las prioriza según sus comisiones.</p>
						</div>
						<div data-stage="3" style="position:absolute;inset:0;opacity:0;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;">
							<div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.28em;color:#f7931a;">STEP 04 / 06 — PROOF OF WORK</div>
							<p style="margin:0;color:#c9c8c2;font-size:16px;line-height:1.5;">Millones de intentos por segundo hasta encontrar un hash válido para el bloque.</p>
						</div>
						<div data-stage="4" style="position:absolute;inset:0;opacity:0;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;">
							<div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.28em;color:#f7931a;">STEP 05 / 06 — BLOQUE AGREGADO</div>
							<p style="margin:0;color:#c9c8c2;font-size:16px;line-height:1.5;">El bloque válido se propaga por la red y todos los nodos convergen en la misma cadena.</p>
						</div>
						<div data-stage="5" style="position:absolute;inset:0;opacity:0;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;">
							<div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.28em;color:#f7931a;">STEP 06 / 06 — CONFIRMACIONES</div>
							<p style="margin:0;color:#c9c8c2;font-size:16px;line-height:1.5;">Cada bloque adicional entierra más profundamente tu transacción: más confirmaciones, más irreversible.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<Glosario />
		<section style="min-height:60vh;min-height:60dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:60px 24px;border-top:1px solid rgba(242,241,237,.08);">
			<div style="width:44px;height:44px;border-radius:50%;border:1.5px solid #3ddc84;display:flex;align-items:center;justify-content:center;color:#3ddc84;font-size:20px;box-shadow:0 0 24px rgba(61,220,132,.25);">
				✓
			</div>
			<div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.24em;color:#3ddc84;">TX 4b3f…a2d1 · CONFIRMADA</div>
			<p style="margin:0;color:#8b8f9c;font-size:17px;text-align:center;max-width:480px;line-height:1.5;">
				Ahora sabes qué ocurre realmente con tu Bitcoin cuando presionas enviar.
			</p>
			<div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;">
				<button
					id="restart-btn"
					class="tx-btn-ghost"
					style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;background:none;color:#f7931a;border:1px solid rgba(247,147,26,.5);padding:12px 26px;cursor:pointer;"
					>↺ REPETIR SIMULACIÓN</button
				>
				<button
					class="tx-btn-primary"
					data-goto-view="explorador"
					style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;background:#f7931a;color:#0b0c0f;border:none;padding:12px 26px;cursor:pointer;font-weight:700;"
					>RASTREAR ESTA TX →</button
				>
			</div>
		</section>
	</div>
</div>
